NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
HUMSAFAR_NOTIFICATION_SECRET=
# Server-only credentials. Never prefix these with NEXT_PUBLIC_ or expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=
DRIVER_VERIFICATION_MODEL_URL=
DRIVER_VERIFICATION_MODEL_KEY=
# Defaults: OCR engine confidence 0.90 and cosine similarity 0.383. Calibrate against representative licence/selfie images before production.
DRIVER_VERIFICATION_OCR_MIN_CONFIDENCE=0.90
DRIVER_VERIFICATION_FACE_MIN_SCORE=0.383
# Optional self-hosted or licensed Photon endpoint:
# PHOTON_SEARCH_URL=

# Free OpenFreeMap vector style (no API key):
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# OSRM-compatible server. Public FOSSGIS is for light pilot use only.
ROAD_ROUTING_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving/
